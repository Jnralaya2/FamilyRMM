# Copy values into a local, untracked .env file before running outside development.
RMM_ENV=development
RMM_HOST=127.0.0.1
RMM_PORT=3001
RMM_DB_PATH=./data/rmm.sqlite
# Leave blank for development; the server generates a random one-time setup token at startup.
# For production, generate 32 random bytes with:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64url'))"
# Put the generated value in your untracked .env or secret manager. Never commit it.
RMM_SETUP_TOKEN=
# Set to 1 only when HTTPS terminates in a trusted reverse proxy.
RMM_COOKIE_SECURE=0
# Production alternative to RMM_ENROLLMENT_PRIVATE_KEY. The PEM file must be readable only by the application.
# RMM_ENROLLMENT_PRIVATE_KEY_FILE=/run/secrets/enrollment_private_key
