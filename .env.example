# Copy values into a local, untracked .env file before running outside development.
RMM_ENV=development
RMM_HOST=127.0.0.1
RMM_PORT=3001
RMM_DB_PATH=./data/rmm.sqlite
# In production, supply a high-entropy one-time owner bootstrap secret via a secret manager.
RMM_SETUP_TOKEN=
# Set to 1 only when HTTPS terminates in a trusted reverse proxy.
RMM_COOKIE_SECURE=0
